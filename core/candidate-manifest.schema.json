{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasonkit.dev/schemas/v0.2/candidate-manifest.schema.json",
  "title": "ReasonKit v0.2 candidate manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "candidate_version",
    "source_commit",
    "candidate_manifest_sha256",
    "kernel_sha256",
    "module_manifest_sha256",
    "covered_files"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^rk2-[a-z0-9][a-z0-9.-]*$"
    },
    "candidate_version": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "candidate_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "kernel_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "module_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "covered_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/coveredFile"
      }
    }
  },
  "$defs": {
    "coveredFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_relative_path",
        "sha256",
        "bytes",
        "role"
      ],
      "properties": {
        "repository_relative_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "type": "string",
          "enum": [
            "kernel",
            "module_registry",
            "loadable_module",
            "specialist_gate",
            "telemetry_schema",
            "candidate_schema",
            "runner",
            "implementation_module",
            "adapter",
            "generated_artifact",
            "other"
          ]
        },
        "module_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
